  "resource_types": [
    {"name": "node_f", "cores": 192, "memory_gb": 768, "gpus": 4, "local_scratch_gib": 1660, "default": true},
    {"name": "node_h", "cores": 96, "memory_gb": 384, "gpus": 2, "local_scratch_gib": 830},
    {"name": "node_q", "cores": 48, "memory_gb": 192, "gpus": 1, "local_scratch_gib": 415},
    {"name": "node_o", "cores": 24, "memory_gb": 96, "gpus": 0.5, "local_scratch_gib": 200, "mig": true},
    {"name": "gpu_1", "cores": 8, "memory_gb": 96, "gpus": 1, "local_scratch_gib": 200},
    {"name": "gpu_h", "cores": 4, "memory_gb": 48, "gpus": 0.5, "local_scratch_gib": 100, "mig": true},
